# ===== 必填 =====

# 嵌入模型（OpenAI 兼容接口：POST {EMBEDDING}/embeddings）
# 例：https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING=
EMBEDDING_API_KEY=

# 判标题层级用的对话模型（OpenAI 兼容：POST {OPENAI_BASE_URL}/chat/completions）
OPENAI_BASE_URL=
OPENAI_API_KEY=
CHAT_MODEL=deepseek-flash

# ===== 可选 =====

# 重排模型（DashScope 原生 rerank 接口，不是 OpenAI 兼容路径）
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank

# Elasticsearch
PAPER_RAG_ES_URL=http://localhost:9200
PAPER_RAG_ES_INDEX=papers

# 切分阈值：嵌入模型能吃的最大字符数，超过就拆父子块
# 英文 512 token 约 2000 字符；中文要调小到 600 左右
PAPER_RAG_EMBED_MAX_CHARS=2000
PAPER_RAG_CHILD_TARGET_CHARS=1200

# 检索：候选数决定重排费用，final 决定塞给模型的段数
PAPER_RAG_RETRIEVE_CANDIDATES=10
PAPER_RAG_RETRIEVE_TOP_N=2
PAPER_RAG_PROMPT_CHAR_BUDGET=24000

# 缓存目录（同一篇论文重跑不重复花 LLM 与 embedding 费用）
PAPER_RAG_CACHE_DIR=data/cache

# PDF 转 markdown 用的解析服务（如果接 MCP 服务端并按需入库才需要）
MINERU_API_TOKEN=
